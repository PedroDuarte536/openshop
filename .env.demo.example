# Copy to .env.demo and fill in. Used by scripts/seed-demo.py and the API.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-demo-password
AUTH_SECRET=change-me-long-random-string
DB_PATH=./demo-data/db.sqlite
UPLOAD_DIR=./demo-data/uploads
PORT=3000
IMPORT_MEDIA_DIR=./demo-data/import-media
# Optional: absolute staff invitation links (the backoffice address)
# BACKOFFICE_URL=http://localhost:4200
# Optional, behind a reverse proxy: its address(es) or CIDR (not "true"), see docs/backoffice-hosting.md
# TRUST_PROXY=10.0.0.5
